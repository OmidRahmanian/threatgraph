# Python
.venv/
__pycache__/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Node / Next.js
node_modules/
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts
apps/web/test-results/
