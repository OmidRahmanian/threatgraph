# --- API (apps/api) ---------------------------------------------------------
TG_DATASET=demo                          # dataset name from configs/datasets.yaml
TG_PUBLIC_IDS=true                       # alias real-data identifiers in responses (no effect on synthetic)
TG_CORS_ORIGINS=http://localhost:3000    # comma-separated allowed origins
TG_RATE_LIMIT_PER_MINUTE=240             # per client address, in-memory
# TG_DATASETS_CONFIG=/path/to/datasets.yaml   # optional alternate dataset config

# --- Web (apps/web) ---------------------------------------------------------
# Leave empty to read the static export in public/threatgraph-data/.
NEXT_PUBLIC_TG_API_BASE=
# NEXT_PUBLIC_TG_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_TG_DATASET=demo
# Sub-path when embedded in another site, e.g. /projects  (pages then live at /projects/threatgraph)
NEXT_PUBLIC_BASE_PATH=
# Shown as GitHub/methodology links when set.
NEXT_PUBLIC_REPO_URL=

# --- Live Monitoring Mode (docker compose --profile live; docs/live/configuration.md) -----
# Put real values in .env (compose variables) and .env.live (service secrets); both are
# git-ignored. Every secret also accepts NAME_FILE=/run/secrets/... instead of NAME.
TG_DOMAIN=localhost                       # public host name served by Caddy (automatic HTTPS)
TG_INGEST_ADDRESS=https://localhost:8443  # ingestion site address (use your private IP)
TG_INGEST_BIND=127.0.0.1                  # host interface for port 8443; never 0.0.0.0
TG_LIVE_ADMIN_USER=admin
TG_LIVE_ADMIN_PASSWORD_HASH=              # output of: threatgraph-live hash-password
TG_LIVE_COOKIE_SECURE=true                # keep true behind HTTPS
# Web build for a deployment with live monitoring (same origin as the dashboard API):
# NEXT_PUBLIC_TG_LIVE_API_BASE=/live-api/v1

# --- .env.live (worker and dashboard secrets) ---------------------------------------------
# TG_TELEGRAM_BOT_TOKEN=
# TG_TELEGRAM_CHAT_ID=
# TG_SMTP_HOST=smtp.example.com
# TG_SMTP_PORT=587
# TG_SMTP_SECURITY=starttls               # starttls | ssl | none (local relay only)
# TG_SMTP_USER=
# TG_SMTP_PASSWORD=
# TG_SMTP_FROM=threatgraph@example.com
# TG_SMTP_TO=you@example.com
# TG_NOTIFY_LIVE_TEST=1                   # opt-in: lets pytest send one real test message
