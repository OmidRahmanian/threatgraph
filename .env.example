# --- API (apps/api) ---------------------------------------------------------
TG_DATASET=demo                          # dataset name from configs/datasets.yaml
TG_PUBLIC_IDS=true                       # alias real-data identifiers in responses (no effect on synthetic)
TG_CORS_ORIGINS=http://localhost:3000    # comma-separated allowed origins
TG_RATE_LIMIT_PER_MINUTE=240             # per client address, in-memory
# TG_DATASETS_CONFIG=/path/to/datasets.yaml   # optional alternate dataset config

# --- Web (apps/web) ---------------------------------------------------------
# Leave empty to read the static export in public/threatgraph-data/.
NEXT_PUBLIC_TG_API_BASE=
# NEXT_PUBLIC_TG_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_TG_DATASET=demo
# Sub-path when embedded in another site, e.g. /projects  (pages then live at /projects/threatgraph)
NEXT_PUBLIC_BASE_PATH=
# Shown as GitHub/methodology links when set.
NEXT_PUBLIC_REPO_URL=
